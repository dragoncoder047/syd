{
    "compilerOptions": {
        "noEmit": true,
        "target": "ESNext",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitAny": true,
        "noFallthroughCasesInSwitch": true,
        "strictNullChecks": true,
        "moduleResolution": "Bundler",
        "module": "ESNext",
        "types": [
            "bun",
            "audioWorklet"
        ],
    },
    "include": [
        "./**/*.ts"
    ],
    "exclude": [
        "./node_modules/**/*.ts",
        "./beepmods/**/*.ts"
    ]
}