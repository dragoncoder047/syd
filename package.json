{
    "name": "syd",
    "version": "0.1.0",
    "description": "",
    "exports": {
        ".": {
            "import": {
                "types": "./src/index.ts",
                "import": "./src/index.ts",
                "require": "./build/index.js"
            }
        },
        "./worklet": {
            "import": {
                "types": "./src/sydWorklet.ts",
                "default": "./build/sydWorklet.js"
            }
        }
    },
    "scripts": {
        "build": "bun run scripts/build",
        "dev:build": "bun nodemon -e js,json,ts,css,md,html -i docs -w src -w website -w scripts --exec \"bun run build\"",
        "dev:serve": "python3 -m http.server",
        "dev": "bun run --parallel \"dev:*\"",
        "lint": "bun tsc",
        "test": "bun test --todo",
        "test:watch": "bun test --watch",
        "prepare": "bun run build --minify",
        "fetchdata": "python3 scripts/fetch_data.py"
    },
    "keywords": [],
    "author": "dragoncoder047",
    "license": "AGPL-3.0-only",
    "devDependencies": {
        "@types/audioworklet": "^0.0.87",
        "@types/bun": "^1.3.2",
        "@types/node": "^24.3.1",
        "bun": "^1.2.21"
    },
    "dependencies": {
        "@r47onfire/game-math": "github:r47onfire/game-math",
        "lib0": "^0.2.117",
        "microdiff": "^1.5.0",
        "nodemon": "^3.1.14"
    }
}